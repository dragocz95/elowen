{
  "name": "work",
  "version": "0.1.0",
  "apiVersion": "1",
  "description": "Task tracking: the work domain — tasks, epics and phases, their dependency graph, the plan/replan endpoints and the per-task usage snapshots, plus the control-plane tools an agent uses to drive them. Extracted from the Elowen core onto the plugin platform; disabling it turns off task tracking entirely (and with it missions, which are built on tasks) while chat, memory, projects and the rest of the agent keep working.",
  "entry": "dist/index.js",
  "capabilities": {
    "reads": [
      "db",
      "stores",
      "controls",
      "elowen-cli",
      "config",
      "git",
      "brain-worker",
      "tmux",
      "inference",
      "prompts"
    ],
    "mutates": [
      "events"
    ]
  },
  "provides": {
    "apiRoutes": [
      "/tasks",
      "/tasks/ready",
      "/tasks/deps",
      "/tasks/plan",
      "/tasks/:id",
      "/tasks/:id/usage",
      "/tasks/:id/conversation",
      "/tasks/:id/deps",
      "/tasks/:id/changed/diff",
      "/tasks/:id/commits",
      "/tasks/:id/commit/:hash/diff",
      "/tasks/:epicId/phases",
      "/plan/:jobId",
      "/plan/:jobId/submit"
    ],
    "tools": [
      "ElowenListTasks",
      "ElowenCreateTask",
      "ElowenUpdateTask",
      "ElowenPlan",
      "ElowenGetTask",
      "ElowenStopTask",
      "ElowenTaskOutput"
    ],
    "skills": [
      "elowen-tasks"
    ],
    "mcpTools": [
      "elowen_tasks",
      "elowen_create_task",
      "elowen_plan",
      "elowen_task_update",
      "elowen_task_close",
      "elowen_task_usage"
    ]
  },
  "planSafe": [
    "ElowenListTasks"
  ],
  "web": {
    "entry": "web/index.js",
    "requiresApiVersion": 1,
    "label": "Work",
    "nav": [
      {
        "label": "Tasks",
        "icon": "ListChecks",
        "route": "tasks"
      },
      {
        "label": "Kanban",
        "icon": "KanbanSquare",
        "route": "kanban"
      },
      {
        "label": "Timeline",
        "icon": "Activity",
        "route": "timeline"
      },
      {
        "label": "Stats",
        "icon": "BarChart3",
        "route": "stats"
      }
    ],
    "strings": {
      "kbBoard": "Board",
      "kbCalendar": "Calendar",
      "kbWorkspaceEyebrow": "Flow control",
      "kbWorkspaceIntro": "Move work through execution states or schedule it on the shared calendar.",
      "kbWorkspaceReady": "Board synchronized",
      "kbColumnOpen": "Open",
      "kbColumnInProgress": "In progress",
      "kbColumnBlocked": "Blocked",
      "kbColumnClosed": "Closed",
      "kbColumnCancelled": "Cancelled",
      "kbBlockedDeps": "Blocked by unfinished dependencies",
      "kbTrueStatusTooltip": "True status: {status}",
      "tlWorkspaceEyebrow": "Operational history",
      "tlWorkspaceIntro": "Tasks, missions, reviews and agent signals aligned on one shared time axis.",
      "tlWorkspaceReady": "Activity synchronized",
      "tlDetailTitle": "Event detail",
      "tlActivityWeek": "Activity / last week",
      "tlActivityDays": "Activity / last {n} days",
      "tlActivityHours": "Activity / last {n}h",
      "tlLoadError": "Failed to load activity",
      "tlEmpty": "No activity yet",
      "tlEmptyDescription": "Events from the last 12 hours appear here.",
      "tlFilterAll": "All",
      "tlFilterTasks": "Tasks",
      "tlFilterMissions": "Missions",
      "tlFilterSignals": "Signals",
      "tlFilterReviews": "Reviews",
      "tlAxis": "Axis",
      "tlLanes": "Lanes",
      "tlApproved": "Approved",
      "tlEscalated": "Escalated",
      "tlNoChanges": "No working-tree changes",
      "tlOpenTask": "Open task",
      "tlMarkerHint": "Click an event for details and repo changes",
      "tlChangesOverTime": "Changes over time",
      "tlMostActiveFiles": "Most active files",
      "tlNoChangesInWindow": "No commits in this window"
    }
  }
}
