{
  "name": "work",
  "version": "0.1.0",
  "apiVersion": "1",
  "description": "Task tracking: the work domain — tasks, epics and phases, their dependency graph, the plan/replan endpoints and the per-task usage snapshots, plus the control-plane tools an agent uses to drive them. Extracted from the Elowen core onto the plugin platform; disabling it turns off task tracking entirely (and with it missions, which are built on tasks) while chat, memory, projects and the rest of the agent keep working.",
  "entry": "dist/index.js",
  "capabilities": {
    "reads": [
      "db",
      "stores",
      "controls",
      "elowen-cli",
      "config",
      "git",
      "brain-worker",
      "tmux",
      "inference",
      "prompts"
    ],
    "mutates": [
      "events"
    ]
  },
  "provides": {
    "tools": [
      "ElowenListTasks",
      "ElowenCreateTask",
      "ElowenUpdateTask",
      "ElowenPlan",
      "ElowenGetTask",
      "ElowenStopTask",
      "ElowenTaskOutput"
    ],
    "mcpTools": [
      "elowen_tasks",
      "elowen_create_task",
      "elowen_plan",
      "elowen_task_update",
      "elowen_task_close",
      "elowen_task_usage"
    ]
  },
  "planSafe": [
    "ElowenListTasks"
  ],
  "web": {
    "entry": "web/index.js",
    "requiresApiVersion": 1,
    "nav": [
      { "label": "Tasks", "icon": "ListChecks", "route": "tasks" },
      { "label": "Kanban", "icon": "KanbanSquare", "route": "kanban" },
      { "label": "Timeline", "icon": "Activity", "route": "timeline" },
      { "label": "Stats", "icon": "BarChart3", "route": "stats" }
    ]
  }
}
