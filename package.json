{
  "name": "elowen",
  "version": "0.28.11",
  "description": "Elowen is a self-hosted personal AI agent you talk to: chat, act, automate and extend from the CLI, web, Discord, Telegram, Microsoft Teams or WhatsApp.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/dragocz95/elowen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragocz95/elowen.git"
  },
  "bugs": {
    "url": "https://github.com/dragocz95/elowen/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "personal-agent",
    "self-hosted",
    "automation",
    "plugins",
    "llm",
    "cli",
    "tmux"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "elowen": "dist/cli/bin.js",
    "elo": "dist/cli/bin.js"
  },
  "files": [
    "dist/",
    "web-dist/",
    "prompts/",
    "plugins/",
    "docs/site/*.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./plugin-api": {
      "types": "./dist/plugins/api.d.ts",
      "default": "./dist/plugins/api.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./plugins/*": "./plugins/*"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "npm run languages-check --silent && node scripts/dist-integrity.mjs clean",
    "build:ts": "tsc -b tsconfig.json $(ls tsconfig.plugins.*.json 2>/dev/null)",
    "build": "npm run build:ts --silent && npm run build:plugins-web --silent && cp src/store/schema.sql dist/store/ && cp -r prompts dist/ && cp -r plugins dist/",
    "build:plugins-web": "node scripts/build-plugins-web.mjs",
    "postbuild": "node scripts/dist-integrity.mjs chmod-bins && node scripts/dist-integrity.mjs verify",
    "check:dist": "node scripts/dist-integrity.mjs verify",
    "models:refresh": "node scripts/refresh-model-capabilities.mjs",
    "build:web": "node scripts/build-web-bundle.mjs",
    "prepublishOnly": "npm run build && npm run build:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cli-tmux": "npm run build --silent && npm run test:cli-tmux:built",
    "test:cli-tmux:built": "node scripts/tests/cli-tmux-built.mjs",
    "test:cli-tmux:goal": "npm run build --silent && node scripts/tests/cli-tmux-goal.mjs",
    "test:cli-tmux:stop": "npm run build --silent && node scripts/tests/cli-tmux-stop-escalation.mjs",
    "test:cli-tmux:analyze": "node scripts/tests/cli-tmux-analyze.mjs",
    "test:e2e:brain": "npm run build --silent && node scripts/tests/brain-e2e/chat-turn.mjs",
    "test:e2e:stop-kill": "npm run build --silent && node scripts/tests/brain-e2e/stop-kill.mjs",
    "test:e2e:continuity": "npm run build --silent && node scripts/tests/continuity-e2e/run.mjs",
    "test:e2e:hooks": "npm run build --silent && node scripts/tests/hooks-e2e/run.mjs",
    "test:e2e:api": "npm run build --silent && node scripts/tests/api-e2e/run.mjs",
    "test:e2e:migration": "npm run build --silent && node scripts/tests/migration-e2e/run.mjs",
    "test:e2e:web": "npm run build --silent && npm run build:web && node scripts/tests/web-e2e/run.mjs",
    "test:e2e:delegate": "npm run build --silent && node scripts/tests/delegate-e2e/run.mjs",
    "test:e2e:subagent": "npm run build --silent && node scripts/tests/subagent-e2e/run.mjs",
    "test:e2e:subagent:runner": "npm run build --silent && ELOWEN_SUBAGENT_RUNNER=1 node scripts/tests/subagent-e2e/run.mjs",
    "test:e2e:workflow": "npm run build --silent && node scripts/tests/workflow-e2e/run.mjs",
    "test:install": "node scripts/install-smoke/run.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "languages-check": "node --experimental-strip-types --no-warnings scripts/check-languages.mjs",
    "depcruise": "depcruise src web plugins --config .dependency-cruiser.cjs",
    "depgraph": "depcruise src web plugins --config .dependency-cruiser.cjs --output-type dot | dot -T svg -o dependency-graph.svg",
    "deadcode": "knip",
    "check": "npm run lint && npm run deadcode && npm run depcruise && npm run typecheck && npm run languages-check",
    "serve": "node --experimental-strip-types src/daemon/index.ts",
    "test:e2e:parity": "node scripts/tests/subagent-parity/run.mjs --check scripts/tests/subagent-parity/baseline.json",
    "test:e2e:parity:runner": "ELOWEN_SUBAGENT_RUNNER=1 node scripts/tests/subagent-parity/run.mjs --check scripts/tests/subagent-parity/baseline.json",
    "test:e2e:parity:mcp": "ELOWEN_PARITY_MCP=1 node scripts/tests/subagent-parity/run.mjs --check scripts/tests/subagent-parity/baseline-mcp.json",
    "test:e2e:parity:mcp:runner": "ELOWEN_PARITY_MCP=1 ELOWEN_SUBAGENT_RUNNER=1 node scripts/tests/subagent-parity/run.mjs --check scripts/tests/subagent-parity/baseline-mcp.json",
    "test:e2e:parity:mcp:deferred": "ELOWEN_PARITY_MCP=deferred node scripts/tests/subagent-parity/run.mjs --check scripts/tests/subagent-parity/baseline-mcp-deferred.json",
    "test:e2e:parity:mcp:deferred:runner": "ELOWEN_PARITY_MCP=deferred ELOWEN_SUBAGENT_RUNNER=1 node scripts/tests/subagent-parity/run.mjs --check scripts/tests/subagent-parity/baseline-mcp-deferred.json",
    "test:e2e:lazy-mcp": "npm run build --silent && node scripts/tests/subagent-lazy-mcp/run.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "baileys": "^7.0.0-rc13",
    "better-sqlite3": "^11.0.0",
    "botframework-connector": "^4.23.3",
    "elowen-plugin-shared": "0.1.3",
    "grammy": "^1.44.0",
    "hono": "^4.6.0",
    "jose": "^5.10.0",
    "qrcode": "^1.5.4",
    "shiki": "^4.3.1",
    "typebox": "^1.1.38",
    "web-push": "^3.6.7",
    "ws": "^8.21.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "overrides": {
    "@hono/node-server": "$@hono/node-server",
    "protobufjs": "^7.6.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.12",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "dependency-cruiser": "^17.4.3",
    "elowen-plugin-ui-kit": "0.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.8.0",
    "knip": "^6.17.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.10"
  }
}
