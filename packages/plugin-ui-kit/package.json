{
  "name": "elowen-plugin-ui-kit",
  "version": "0.1.0",
  "description": "Contract types and esbuild toolchain for building Elowen plugin browser-UI bundles.",
  "license": "MIT",
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./build": {
      "types": "./build.d.ts",
      "default": "./build.js"
    }
  },
  "bin": {
    "elowen-plugin-ui-build": "./bin.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "build.js",
    "build.d.ts",
    "bin.js",
    "shims/",
    "theme.css",
    "README.md"
  ],
  "dependencies": {
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  }
}
