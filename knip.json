{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "plugins/**/index.mjs",
        "plugins/*/src/index.ts",
        "plugins/*/web-src/index.tsx"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "plugins/**/*.mjs",
        "plugins/**/src/**/*.ts",
        "plugins/**/web-src/**/*.{ts,tsx}"
      ]
    },
    "web": {
      "entry": [
        "app/providers.tsx"
      ],
      "ignore": [
        "tests/e2e/**",
        "playwright.config.ts"
      ],
      "playwright": false
    }
  },
  "ignoreBinaries": [
    "dot",
    "elowen",
    "ollama",
    "pgrep"
  ],
  "ignoreIssues": {
    "src/plugins/api.ts": [
      "types"
    ],
    "src/brain/transcript.ts": [
      "types"
    ],
    "web/lib/transcript.ts": [
      "exports"
    ],
    "plugins/_shared/lifecycle.mjs": [
      "exports"
    ],
    "web/lib/types.ts": [
      "types"
    ],
    "plugins/agents/src/lib/execs.ts": [
      "exports"
    ]
  },
  "ignore": [
    "web/public/sw.js"
  ],
  "ignoreDependencies": [
    "@types/react",
    "@types/react-dom",
    "lucide-react",
    "react",
    "marked",
    "dompurify",
    "@monaco-editor/react",
    "@testing-library/react",
    "@tanstack/react-query",
    "msw"
  ]
}
