{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreUnresolved": [
        "/usr/bin/certbot"
      ],
      "entry": [
        "plugins/**/index.mjs",
        "plugins/*/web-src/index.tsx"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "plugins/**/*.mjs",
        "plugins/**/web-src/**/*.{ts,tsx}"
      ]
    },
    "web": {
      "entry": [
        "app/providers.tsx"
      ],
      "ignore": [
        "tests/e2e/**",
        "playwright.config.ts",
        "lib/chatPresentation.ts"
      ],
      "playwright": false
    },
    "packages/plugin-shared": {
      "entry": [
        "*.mjs",
        "index.d.mts"
      ]
    },
    "packages/plugin-ui-kit": {
      "entry": [
        "shims/*.cjs",
        "theme.css"
      ],
      "ignoreDependencies": [
        "tailwindcss"
      ]
    }
  },
  "ignoreBinaries": [
    "dot",
    "elowen",
    "ollama",
    "pgrep"
  ],
  "ignoreIssues": {
    "src/plugins/api.ts": [
      "types"
    ],
    "packages/plugin-shared/lifecycle.mjs": [
      "exports"
    ],
    "web/components/ui/shadcn/select.tsx": [
      "exports"
    ],
    "web/components/ui/shadcn/input.tsx": [
      "exports"
    ],
    "web/components/ui/shadcn/textarea.tsx": [
      "exports"
    ],
    "web/components/ui/shadcn/dropdown-menu.tsx": [
      "exports"
    ],
    "web/components/ui/shadcn/context-menu.tsx": [
      "exports"
    ],
    "web/components/ui/shadcn/tooltip.tsx": [
      "exports"
    ],
    "web/components/ui/shadcn/command.tsx": [
      "exports"
    ],
    "web/components/ui/shadcn/sidebar.tsx": [
      "exports"
    ],
    "web/components/ui/shadcn/chart.tsx": [
      "exports"
    ]
  },
  "ignore": [
    "web/public/sw.js"
  ],
  "ignoreDependencies": [
    "@types/react",
    "lucide-react",
    "botframework-connector",
    "grammy",
    "baileys",
    "qrcode",
    "puppeteer-core",
    "proxy-chain"
  ]
}
