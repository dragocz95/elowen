{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "outDir": "plugins/work/dist",
    "rootDir": "plugins/work/src",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "declaration": false,
    "tsBuildInfoFile": "plugins/work/dist/.tsbuildinfo"
  },
  "references": [
    { "path": "./tsconfig.json" }
  ],
  "include": ["plugins/work/src/**/*"]
}
