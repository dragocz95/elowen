__pycache__/
*.pyc

# Built web bundle (npm package artifact)
web-dist/

# npm pack artifacts
*.tgz
.opencode/
.worktrees/

# image-gen plugin scratch (chroma-key sources / temp renders)
.imagegen-tmp/
/.config/

# Built plugin output (each TypeScript plugin is its own compile unit — tsconfig.plugins.<name>.json,
# all built by npm run build:ts). One line per TypeScript plugin.
plugins/code-mode/dist/
*.tsbuildinfo

# Built plugin UI bundles (generated by npm run build:plugins-web from plugins/*/web-src). Named one by
# one rather than a blanket plugins/*/web/, so a plugin that ships a hand-written (build-free) bundle
# stays tracked instead of being silently ignored.
plugins/subagent/web/
plugins/sandbox/web/
plugins/mcp/web/
plugins/msteams/web/
plugins/changelog/web/

# Built root filesystem artifacts. Hundreds of megabytes; the pins and the publish manifest are
# what belongs in the repository, the tarballs belong on a release.
.artifacts/
